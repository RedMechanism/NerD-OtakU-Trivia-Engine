<Page x:Class="NOTE.NerdFeud_Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:NOTE"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="NerdFeud_Page">
    <Page.Background>
        <ImageBrush ImageSource="Images/NerdFeud.png" Opacity="0.8"/>
    </Page.Background>
    <Page.Resources>
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="30">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="Orange" />
            <Setter Property="BorderBrush" Value="DarkGray" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="false">
                    <Setter Property="Opacity" Value="0.5" />
                    <Setter Property="Foreground" Value="Gray"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="QuestionTextbox" Grid.Row="0" Grid.RowSpan="1" Width="800" Margin="0,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" TextWrapping="WrapWithOverflow" FontWeight="Bold" FontSize="48" Foreground="White" Text="Text goes here even if it is multiple lines it still goes here">
            <TextBlock.Effect>
                <DropShadowEffect Color="Black" Direction="320" ShadowDepth="3" Opacity="0.5" BlurRadius="4"/>
            </TextBlock.Effect>
        </TextBlock>
        <Grid x:Name="grid" Grid.Row="1" Margin="0,34,0,0" Grid.RowSpan="2"/>
        <Label x:Name="CurrentQuestionNameLabel" Content="Name" Grid.Row="2" FontSize="34" FontFamily="Arial Black" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
        <Label x:Name="CurrentTeamLabel" Content="Team" Grid.Row="2" FontSize="34" FontFamily="Arial Black" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
    </Grid>
</Page>